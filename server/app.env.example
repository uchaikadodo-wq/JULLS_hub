# Never use these placeholders for deployment. Store real file outside Git/build context.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://base.lookin.team
# Restore the existing database with its SAME APP_KEY. Do not regenerate on migration.
APP_KEY=__PRESERVE_EXISTING_APP_KEY_WHEN_RESTORING__
APP_THEME=lookin-base
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bookstack
DB_USERNAME=bookstack
DB_PASSWORD=__NEW_SERVER_DB_PASSWORD_MATCHING_SECRET_FILE__
STORAGE_TYPE=local
STORAGE_IMAGE_TYPE=local_secure_restricted
SESSION_SECURE_COOKIE=true
SESSION_COOKIE_NAME=lookin_base_session
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
DISABLE_EXTERNAL_SERVICES=true
ALLOW_UNTRUSTED_SERVER_FETCHING=false
# Temporary pilot sink; SMTP must be configured before email invitations/resets are needed.
MAIL_DRIVER=array
MAIL_FROM=__SET_SENDER_EMAIL__
MAIL_FROM_NAME="Lookin.Team Base"
API_REQUESTS_PER_MIN=120

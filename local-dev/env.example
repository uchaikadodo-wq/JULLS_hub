# Generated local-only credentials. Never copy this file to a server.
APP_ENV=local
APP_DEBUG=false
APP_KEY=__GENERATED_KEY__
APP_URL=http://127.0.0.1:8080
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bookstack-dev
DB_USERNAME=bookstack-local
DB_PASSWORD=synthetic-local-only
TEST_DATABASE_URL=mysql://bookstack-local:synthetic-local-only@db:3306/bookstack-test
MAIL_DRIVER=log
MAIL_FROM=bookstack@example.test
MAIL_FROM_NAME="Local BookStack"
DISABLE_EXTERNAL_SERVICES=true
ALLOW_UNTRUSTED_SERVER_FETCHING=false
STORAGE_TYPE=local
QUEUE_CONNECTION=sync
COMPOSE_FILE=compose.local.yaml
APP_THEME=lookin-base

# Images are served with page access checks, outside the public web directory.
STORAGE_IMAGE_TYPE=local_secure_restricted
